# The checker alone, for a free host like Render. The web app is the static site on GitHub Pages.
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.13 /uv /bin/
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg fonts-noto-core fonts-noto-cjk libraqm0 \
    && rm -rf /var/lib/apt/lists/*
RUN useradd -m -u 1000 user
USER user
ENV HOME=/home/user UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy APP_ENV=prod LOG_LEVEL=INFO
WORKDIR /home/user/backend
COPY --chown=user backend/pyproject.toml backend/uv.lock ./
RUN uv sync --python 3.12 --frozen --no-dev --extra media --no-install-project
COPY --chown=user backend/ ./
RUN uv sync --python 3.12 --frozen --no-dev --extra media
EXPOSE 8000
CMD [".venv/bin/python", "-m", "app.local", "--host", "0.0.0.0", "--port", "8000"]
