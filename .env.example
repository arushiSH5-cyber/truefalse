# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=dev                 # dev | test | prod
LOG_LEVEL=INFO

# --- Infrastructure ---
# Postgres with the pgvector extension (docker-compose overrides the host to "postgres")
DATABASE_URL=postgresql+asyncpg://truefalse:truefalse@localhost:5432/truefalse
# Redis for the arq job queue (docker-compose overrides the host to "redis")
REDIS_URL=redis://localhost:6379/0

# --- LLM ---
# Anthropic API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Model used by the claim-extraction, research, judge and compose stages
ANTHROPIC_MODEL=claude-opus-5-5
# Judge panel: comma-separated provider:model, one independent judge each (2-3 recommended).
# Providers: anthropic | openai | google. Judges whose key (or SDK extra) is missing are skipped;
# with fewer than 2 usable judges, ANTHROPIC_MODEL judges alone with three different prompts.
# Example with three vendors: anthropic:claude-opus-5-5,openai:<model id>,google:<model id>
JUDGE_MODELS=anthropic:claude-opus-5-5,anthropic:claude-sonnet-5-5,anthropic:claude-haiku-5-5
# OpenAI key for openai:* judges (needs `uv sync --extra openai`): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Send reasoning_effort to OpenAI; set false if your OpenAI judge model is not a reasoning model
OPENAI_REASONING_EFFORT=true
# Gemini key for google:* judges (needs `uv sync --extra gemini`): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Server-side refusal fallback: if the model declines a request, the API retries it on a fallback model
# (not available for Claude Haiku, so it is never sent for Haiku judges)
LLM_USE_FALLBACKS=true
# USD per million tokens, used only for cost metrics in logs
LLM_INPUT_PRICE_PER_MTOK=4.0
LLM_OUTPUT_PRICE_PER_MTOK=20.0

# --- Messaging platforms ---
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Random string you choose; passed as secret_token to setWebhook and checked on every webhook call
TELEGRAM_WEBHOOK_SECRET=
# WhatsApp Business Cloud API: permanent access token and phone number ID (Meta developer console)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# App secret (App settings > Basic) used to verify X-Hub-Signature-256 on webhook POSTs
WHATSAPP_APP_SECRET=
# Any random string; enter the same value as "Verify token" when configuring the webhook
WHATSAPP_VERIFY_TOKEN=
# Graph API version (latest listed at https://developers.facebook.com/docs/graph-api/changelog/)
WHATSAPP_API_VERSION=v26.0

# --- Web app / PWA ---
# Comma-separated origins allowed to call the API from a browser (the PWA's URL)
WEB_ORIGINS=http://localhost:3000
# Checks per hour per anonymous web client
WEB_CHECKS_PER_HOUR=20
# Noto fonts for share cards in every script (installed in the Docker image)
SHARE_CARD_FONT_DIR=/usr/share/fonts/truetype/noto

# --- Research sources ---
# Google Fact Check Tools API key (Google Cloud console, enable "Fact Check Tools API")
GOOGLE_FACTCHECK_API_KEY=
# Semantic Scholar API key (optional; raises rate limits): https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
# NCBI E-utilities key for PubMed (optional; raises rate limit 3 -> 10 req/s): https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=
# Web search provider: brave | none
SEARCH_PROVIDER=brave
# Brave Search API key (web + news search): https://brave.com/search/api/
SEARCH_API_KEY=
# GDELT news search: free, no key, 65+ languages, last ~3 months of coverage
GDELT_ENABLED=true

# Reuse verdicts for repeated forwards (stored in Redis: claim text, verdict and source links
# only; never user ids or messages). Unverified or uncertain verdicts are never cached.
VERDICT_CACHE_ENABLED=true
VERDICT_CACHE_TTL_DAYS=7

# --- Fact-check index (needs `alembic upgrade head`, the ml extra, and ingested data) ---
FACTCHECK_INDEX_ENABLED=false
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Cosine similarity above which an indexed fact-check counts as a match
MATCH_STRONG_THRESHOLD=0.88

# --- Media (images and article links work out of the box; voice/video/reels need
#     `uv sync --extra media` and ffmpeg) ---
MEDIA_ENABLED=true
# faster-whisper model: tiny | base | small | medium | large-v3 | large-v3-turbo (best accuracy/speed on a GPU;
# small makes more mistakes on names and numbers)
WHISPER_MODEL=small
# Longest audio/video we will process, in seconds
MAX_MEDIA_SECONDS=3600
# Remember perceptual hashes of checked images in Postgres ("seen before" warnings)
IMAGE_HASH_DB=false

# --- AI-content detection ---
# Content Credentials (C2PA, needs `uv sync --extra ai_detect`) and file metadata checks are free
# and run locally. Messaging apps usually strip both, so they mostly help with web uploads,
# files sent as documents, and links.
AI_DETECT_ENABLED=true
# The options below SEND THE USER'S PICTURE/VIDEO FRAMES TO A THIRD PARTY. Enable only if your
# privacy policy allows it. Their scores are treated as weak evidence and are never a verdict.
# Sightengine (AI-image + deepfake models): https://sightengine.com
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# Hive AI-generated content detection: https://thehive.ai
HIVE_API_KEY=
# Reverse image search for recycled photos: Google Cloud Vision API key (enable "Cloud Vision API")
GOOGLE_VISION_API_KEY=
# Local Hugging Face classifiers (`uv sync --extra ai_detect_local`, PyTorch). No default model:
# choose an image-classification / audio anti-spoofing model and measure it with the eval first.
AI_IMAGE_MODEL=
AI_VOICE_MODEL=
# Weak "AI-written text" signal: one extra LLM call per message, never shown to users alone
AI_TEXT_SIGNAL=false

# --- Languages ---
# Optional fastText language-ID model (needs `uv sync --extra lid`), e.g. NLLB lid218e.bin
LID_MODEL_PATH=
# Voice replies (needs `uv sync --extra voice` + ffmpeg)
TTS_ENABLED=true

# --- Pipeline limits ---
MAX_CLAIMS=3
RESEARCH_MAX_TOOL_CALLS=8
RESEARCH_TIME_BUDGET_S=60

# --- Privacy ---
# Secret salt for hashing user identifiers (phone numbers, chat IDs). Use a long random value.
USER_HASH_SALT=change-me

# --- Network ---
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=2
