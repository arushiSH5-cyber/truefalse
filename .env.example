# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=dev                 # dev | test | prod
LOG_LEVEL=INFO

# --- Infrastructure ---
# Postgres with the pgvector extension (docker-compose overrides the host to "postgres")
DATABASE_URL=postgresql+asyncpg://truefalse:truefalse@localhost:5432/truefalse
# Redis for the arq job queue (docker-compose overrides the host to "redis")
REDIS_URL=redis://localhost:6379/0

# --- LLM ---
# Anthropic API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Model used by the claim-extraction, research and judge agents
ANTHROPIC_MODEL=claude-opus-5-5

# --- Messaging platforms ---
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# WhatsApp Business Cloud API: permanent access token and phone number ID (Meta developer console)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# --- Research sources ---
# Google Fact Check Tools API key (Google Cloud console, enable "Fact Check Tools API")
GOOGLE_FACTCHECK_API_KEY=
# Semantic Scholar API key (optional; raises rate limits): https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
# General web search provider API key (provider chosen in Phase 2)
SEARCH_API_KEY=

# --- Privacy ---
# Secret salt for hashing user identifiers (phone numbers, chat IDs). Use a long random value.
USER_HASH_SALT=change-me

# --- Network ---
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=2
